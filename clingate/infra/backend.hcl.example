# Partial backend config, passed with: terraform init -backend-config=backend.hcl -backend-config="key=<stack>/terraform.tfstate"
# Copy to backend.hcl (gitignored via *.hcl is NOT assumed: keep account ids out of git).
bucket       = "clingate-tfstate-<management-account-id>"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "<state_kms_key_arn from bootstrap-state>"
use_lockfile = true # S3-native locking (Terraform >= 1.10); no DynamoDB table
