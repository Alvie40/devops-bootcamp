# Copy to terraform.tfvars (gitignored). Values below are placeholders.
account_emails = {
  security-tooling = "you+aws-sec@example.com"
  staging          = "you+aws-stg@example.com"
  prod             = "you+aws-prod@example.com"
}
alert_emails           = ["you@example.com"]
aws_profile            = "clingate-management"

admin_user = {
  user_name   = "you"
  given_name  = "Given"
  family_name = "Family"
  email       = "you@example.com"
}
